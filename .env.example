# AI Factory — Environment Variables

# LLM provider connection settings.
# Cloud providers are enabled when their API key is set.
# Local/OpenAI-compatible providers can also be enabled by setting a non-empty base URL.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_API_KEY=
OLLAMA_BASE_URL=
OMLX_API_KEY=
OMLX_BASE_URL=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# Email responder (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Slack responder/sensor
SLACK_BOT_TOKEN=xoxb-
SLACK_SIGNING_SECRET=

# Webhook sensor port (optional; defaults are set in main.ts)
WEBHOOK_PORT=3000

# File watcher path (optional)
WATCH_PATH=./watched

# API Server configuration
API_PORT=3001
API_HOST=localhost
API_CORS_ORIGINS=*
API_STATIC_PATH=./dist/ui
